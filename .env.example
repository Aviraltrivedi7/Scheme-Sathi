# ─────────────────────────────────────────────────────────────
# Scheme Sathi — environment configuration
#
# STANDALONE MODE (default when platform vars below are omitted):
#   Requires only DATABASE_URL (+ MySQL). Auth becomes email/password,
#   storage becomes local disk, scheduling becomes in-process.
#   Run: pnpm db:push && pnpm dev
#
# PLATFORM MODE (hosted platform): fill the PLATFORM_* vars and OAuth vars.
# ─────────────────────────────────────────────────────────────

# REQUIRED — MySQL connection (either mode)
DATABASE_URL=mysql://root:scheme-sathi@localhost:3306/scheme_sathi

# ── Standalone mode ─────────────────────────────────────────

# Session JWT secret. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A deterministic dev fallback is used in standalone mode if unset.
# JWT_SECRET=

# First registered account becomes admin automatically. Alternatively set a
# specific email to promote exactly that account on its registration.
# STANDALONE_ADMIN_EMAIL=admin@example.com

# Local document storage directory (default: ./local-storage)
# LOCAL_STORAGE_DIR=./local-storage

# Set to "1" ONLY behind your own reverse proxy (nginx/Caddy/load balancer):
# uses X-Forwarded-For/Proto for real client IPs in rate limits + Secure
# cookies on HTTPS. Spoofable otherwise — keep unset for direct exposure.
# TRUST_PROXY=1

# OPTIONAL — OpenAI-compatible LLM for OCR + help chat (standalone mode only).
# Without it, OCR returns honest low-confidence "manual review" extractions
# and the help chat streams static guidance.
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o

# ── Client build flags ──────────────────────────────────────
# Optional fallback hint only — the client detects the mode at runtime via
# GET /api/auth/mode. Set this just for static previews without a backend:
# VITE_AUTH_MODE=credentials

# ── Platform mode (hosted platform) ─────────────────────────────
# Provide BOTH to switch off standalone mode:
# PLATFORM_API_URL=
# PLATFORM_API_KEY=
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=https://login.example.com
# OAUTH_SERVER_URL=https://login.example.com/api
# OWNER_OPEN_ID=
# JWT_SECRET=
